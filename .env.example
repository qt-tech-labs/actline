DATABASE_URL=postgres://actline:actline@localhost:5432/actline
# Email of the seeded demo user used until real auth exists.
DEMO_USER_EMAIL=demo@actline.app
# Key of the Gemini API, used by the plan-craft skill to draft a plan.
GEMINI_API_KEY=
# Model that crafts the plan.
GEMINI_MODEL=gemini-3.8-flash
# "gemini", "openrouter", "local" or "template" — or a list to try them in order,
# e.g. "local,gemini". Each one that fails hands over to the next.
AI_PLAN_ENGINE=gemini
# How long a plan may take before the template engine takes over (ms).
AI_TIMEOUT_MS=120000

# The local engine: a model server that speaks the OpenAI API (llama.cpp and
# most of the others do). The base URL points at the API root.
LOCAL_AI_BASE_URL=http://localhost:9931/v1
# The model the server has loaded.
LOCAL_AI_MODEL=ggml-org/gpt-oss-20b-GGUF:MXFP4
# Only when the server wants a token.
LOCAL_AI_API_KEY=
# A local model is slower to answer than a hosted one.
LOCAL_AI_TIMEOUT_MS=300000

# OpenRouter (Chat Completions). Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=recursive/flint-v1.0
OPENROUTER_TIMEOUT_MS=300000
